{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(which:*)",
      "Bash(diff:*)",
      "Bash(pwd:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.aws/*)",
      "Read(**/.gcp/*)",
      "Read(**/service-account*.json)",
      "Read(**/.azure/*)",
      "Read(**/terraform.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.ssh/*)",
      "Read(**/.gnupg/*)",
      "Read(**/*.sqlite)",
      "Read(**/*.db)",
      "Read(**/.htpasswd)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)",
      "Read(**/Cargo.lock)",
      "Read(**/poetry.lock)",
      "Read(**/uv.lock)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/target/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gcp/**)",
      "Read(~/.azure/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "best",
  "enableAllProjectMcpServers": true,
  "cleanupPeriodDays": 180,
  "autoMemoryEnabled": false,
  "plansDirectory": "./.claude/plans",
  "outputStyle": "Compressed",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": false,
  "skillListingBudgetFraction": 0.05,
  "skillListingMaxDescChars": 2048,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "best",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
    "API_TIMEOUT_MS": "1800000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$HOME/.claude/hooks/rtk-rewrite.sh\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
